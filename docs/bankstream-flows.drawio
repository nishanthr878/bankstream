        <mxCell id="rMTppRQt1AwlNReHd2rY-10" parent="1" style="text;html=1;strokeColor=#e67e22;fillColor=#fdebd0;align=center;verticalAlign=middle;rounded=1;fontSize=11;fontStyle=1;fontColor=#e67e22;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="WRONG MESSAGE&#xa;HANDLING" vertex="1">
