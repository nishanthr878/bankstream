        </mxCell>
        <mxCell id="3zYKDeG8nNZXjcPaYTb--17" parent="1" style="rounded=1;fillColor=#fadbd8;strokeColor=#c0392b;fontSize=10;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Send msg (PID=42,Seq=7)" vertex="1">
          <mxGeometry height="45" width="160" x="80" y="480" as="geometry" />
        </mxCell>
        <mxCell id="3zYKDeG8nNZXjcPaYTb--18" parent="1" style="rounded=1;fillColor=#fadbd8;strokeColor=#c0392b;fontSize=10;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Timeout — no ack&#xa;(broker may have got it)" vertex="1">
          <mxGeometry height="45" width="160" x="350" y="480" as="geometry" />
        </mxCell>
        <mxCell id="3zYKDeG8nNZXjcPaYTb--19" parent="1" style="rounded=1;fillColor=#fadbd8;strokeColor=#c0392b;fontSize=10;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Producer retries&#xa;(retries=3)" vertex="1">
          <mxGeometry height="45" width="140" x="540" y="480" as="geometry" />
        </mxCell>
        <mxCell id="3zYKDeG8nNZXjcPaYTb--20" parent="1" style="rounded=1;fillColor=#fadbd8;strokeColor=#c0392b;fontSize=10;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="❌ NO idempotence: duplicate stored, consumer sees 2 msgs" vertex="1">
          <mxGeometry height="55" width="220" x="500" y="380" as="geometry" />
        </mxCell>
        <mxCell id="3zYKDeG8nNZXjcPaYTb--21" parent="1" style="rounded=1;fillColor=#d5f5e3;strokeColor=#27ae60;fontSize=10;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="✅ WITH idempotence: PID+Seq deduped by broker → 1 msg only" vertex="1">
          <mxGeometry height="55" width="220" x="500" y="610" as="geometry" />
        </mxCell>
        <mxCell id="3zYKDeG8nNZXjcPaYTb--22" edge="1" parent="1" source="3zYKDeG8nNZXjcPaYTb--17" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#c0392b;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" target="3zYKDeG8nNZXjcPaYTb--18" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3zYKDeG8nNZXjcPaYTb--23" edge="1" parent="1" source="3zYKDeG8nNZXjcPaYTb--18" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#c0392b;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" target="3zYKDeG8nNZXjcPaYTb--19" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3zYKDeG8nNZXjcPaYTb--24" edge="1" parent="1" source="3zYKDeG8nNZXjcPaYTb--19" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#c0392b;fontSize=11;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" target="3zYKDeG8nNZXjcPaYTb--20" value="❌">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3zYKDeG8nNZXjcPaYTb--25" edge="1" parent="1" source="3zYKDeG8nNZXjcPaYTb--19" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#27ae60;fontSize=11;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" target="3zYKDeG8nNZXjcPaYTb--21" value="✅">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="3zYKDeG8nNZXjcPaYTb--26" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="KafkaProducerConfig&#xa;────────────────────────&#xa;acks=all → wait ALL ISR&#xa;idempotence=true → PID+Seq&#xa;max.in.flight=5 (must ≤5)&#xa;retries=3&#xa;linger.ms=5 (batch wait)&#xa;KEY: StringSerializer&#xa;VAL: KafkaAvroSerializer&#xa;schema.registry.url=:8081" vertex="1">
          <mxGeometry height="160" width="220" x="840" y="335" as="geometry" />
        </mxCell>
        <mxCell id="3zYKDeG8nNZXjcPaYTb--27" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Offset Facts&#xa;────────────────────────&#xa;Stored in __consumer_offsets&#xa;NOT in consumer process&#xa;Consumer dies → offset SAFE&#xa;auto-commit = risky (timer)&#xa;MANUAL_IMMEDIATE = safe&#xa;At-least-once + idempotency&#xa;guard = processed_events table" vertex="1">
          <mxGeometry height="155" width="220" x="840" y="525" as="geometry" />
        </mxCell>
        <mxCell id="3zYKDeG8nNZXjcPaYTb--28" parent="1" style="rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Partition Key = accountId&#xa;────────────────────────────────────&#xa;Same key → same partition&#xa;→ single consumer thread&#xa;→ ordered per account&#xa;&#xa;No key → round-robin&#xa;→ no ordering&#xa;&#xa;Fraud detection NEEDS order&#xa;(velocity: tx1,tx2,tx3 in seq)" vertex="1">
          <mxGeometry height="165" width="310" x="1110" y="350" as="geometry" />
        </mxCell>
        <mxCell id="3zYKDeG8nNZXjcPaYTb--29" parent="1" style="rounded=1;fillColor=#e8f4fd;strokeColor=#2980b9;fontSize=11;align=left;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Architecture Decision: acks=all + min.insync.replicas=2 MUST be set together&#xa;acks=1 alone → leader acks → crashes before replication → DATA LOSS&#xa;acks=all alone → ISR shrinks to 1 → waits for 1 only → FALSE SAFETY&#xa;Both together → broker REJECTS if ISR&lt;2 → real guarantee" vertex="1">
          <mxGeometry height="80" width="780" x="90" y="730" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="PJ_YJh3jB11PAkddRrsk" name="Outbox Pattern">
    <mxGraphModel dx="1357" dy="844" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="yJfWwOfNQ-Znc4rAKRkh-1" parent="1" style="text;html=1;fillColor=#1a1a2e;strokeColor=none;align=center;fontStyle=1;fontSize=14;fontColor=#ffffff;whiteSpace=wrap;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Outbox Pattern — Guaranteed Kafka delivery with DB atomicity" vertex="1">
          <mxGeometry height="36" width="1600" x="100" y="340" as="geometry" />
        </mxCell>
        <mxCell id="yJfWwOfNQ-Znc4rAKRkh-2" parent="1" style="text;html=1;fillColor=#fadbd8;strokeColor=#c0392b;align=left;fontStyle=1;fontSize=11;fontColor=#c0392b;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="❌ THE PROBLEM — @Transactional does NOT span Postgres + Kafka" vertex="1">
          <mxGeometry height="24" width="600" x="100" y="385" as="geometry" />
        </mxCell>
        <mxCell id="yJfWwOfNQ-Znc4rAKRkh-3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fadbd8;strokeColor=#c0392b;fontSize=10;align=left;verticalAlign=top;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="// What engineers write:&#xa;@Transactional&#xa;void createTransaction() {&#xa;   repo.save(tx);         // DB write&#xa;   kafka.send(event);     // Kafka write&#xa;}&#xa;&#xa;// What can go wrong:&#xa;repo.save(tx)  ✅ committed&#xa;Kafka DOWN     ❌ event lost forever&#xa;&#xa;// @Transactional does NOT help:&#xa;// JpaTransactionManager = Postgres only&#xa;// Kafka is OUTSIDE transaction boundary&#xa;// No atomic cross-system operation exists" vertex="1">
          <mxGeometry height="210" width="310" x="80" y="520" as="geometry" />
        </mxCell>
        <mxCell id="yJfWwOfNQ-Znc4rAKRkh-4" parent="1" style="text;html=1;fillColor=#d5f5e3;strokeColor=#27ae60;align=left;fontStyle=1;fontSize=11;fontColor=#1e8449;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="✅ HAPPY PATH — Outbox: both DB writes atomic, Kafka publish separate" vertex="1">
          <mxGeometry height="24" width="650" x="310" y="460" as="geometry" />
        </mxCell>
        <mxCell id="yJfWwOfNQ-Znc4rAKRkh-5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="TransactionService&#xa;@Transactional&#xa;────────────────────────&#xa;1. INSERT transactions row&#xa;2. INSERT outbox row&#xa;   topic=&quot;transaction.initiated&quot;&#xa;   payload=Base64(AvroBytes)&#xa;   published=false&#xa;3. TX COMMITS&#xa;   BOTH rows or NEITHER&#xa;&#xa;❌ NO kafka.send() here!" vertex="1">
          <mxGeometry height="195" width="220" x="430" y="520" as="geometry" />
        </mxCell>
        <mxCell id="yJfWwOfNQ-Znc4rAKRkh-6" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Postgres (atomic)&#xa;─────────────────────&#xa;transactions:&#xa;  id, amount, status&#xa;&#xa;outbox:&#xa;  id, topic,&#xa;  partition_key,&#xa;  payload (JSONB/Base64),&#xa;  published=false,&#xa;  retry_count=0,&#xa;  last_error=null" vertex="1">
          <mxGeometry height="185" width="170" x="715" y="525" as="geometry" />
        </mxCell>
        <mxCell id="yJfWwOfNQ-Znc4rAKRkh-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="OutboxPoller&#xa;@Scheduled(fixedDelay=1000ms)&#xa;@Transactional&#xa;────────────────────────────────&#xa;SELECT * FROM outbox&#xa;WHERE published=false&#xa;ORDER BY created_at LIMIT 100&#xa;FOR UPDATE SKIP LOCKED&#xa;↑ multiple instances safe&#xa;&#xa;Base64.decode(payload)→bytes[]&#xa;bytesKafkaTemplate.send(bytes).get()&#xa;↑ synchronous — waits for ack&#xa;&#xa;SET published=true&#xa;SET published_at=now()" vertex="1">
          <mxGeometry height="205" width="265" x="970" y="510" as="geometry" />
        </mxCell>
        <mxCell id="yJfWwOfNQ-Znc4rAKRkh-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Kafka&#xa;transaction.initiated&#xa;──────────────────────&#xa;Receives raw Avro bytes&#xa;[0x00][schemaId][binary]&#xa;&#xa;Consumer&#39;s&#xa;KafkaAvroDeserializer&#xa;reads magic byte&#xa;fetches schema by ID&#xa;returns typed object" vertex="1">
          <mxGeometry height="185" width="200" x="1410" y="520" as="geometry" />
        </mxCell>
        <mxCell id="yJfWwOfNQ-Znc4rAKRkh-9" edge="1" parent="1" source="yJfWwOfNQ-Znc4rAKRkh-5" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#27ae60;fontSize=9;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" target="yJfWwOfNQ-Znc4rAKRkh-6" value="atomic">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="yJfWwOfNQ-Znc4rAKRkh-10" edge="1" parent="1" source="yJfWwOfNQ-Znc4rAKRkh-7" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#d6b656;fontSize=9;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" target="yJfWwOfNQ-Znc4rAKRkh-6" value="reads every 1s">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="yJfWwOfNQ-Znc4rAKRkh-11" edge="1" parent="1" source="yJfWwOfNQ-Znc4rAKRkh-7" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#27ae60;fontSize=9;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" target="yJfWwOfNQ-Znc4rAKRkh-8" value="raw Avro bytes">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="yJfWwOfNQ-Znc4rAKRkh-12" parent="1" style="text;html=1;fillColor=#fadbd8;strokeColor=#c0392b;align=left;fontStyle=1;fontSize=11;fontColor=#c0392b;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="❌ FAILURE PATH — Kafka down → outbox retries → event delivered on recovery" vertex="1">
          <mxGeometry height="24" width="700" x="80" y="860" as="geometry" />
        </mxCell>
        <mxCell id="yJfWwOfNQ-Znc4rAKRkh-13" parent="1" style="rounded=1;fillColor=#fadbd8;strokeColor=#c0392b;fontSize=10;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="TX commits&#xa;Both rows saved&#xa;published=false" vertex="1">
          <mxGeometry height="55" width="140" x="90" y="910" as="geometry" />
        </mxCell>
        <mxCell id="yJfWwOfNQ-Znc4rAKRkh-14" parent="1" style="rounded=1;fillColor=#fadbd8;strokeColor=#c0392b;fontSize=10;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Kafka DOWN&#xa;send().get() throws&#xa;retry_count++&#xa;last_error logged" vertex="1">
          <mxGeometry height="55" width="150" x="340" y="910" as="geometry" />
        </mxCell>
        <mxCell id="yJfWwOfNQ-Znc4rAKRkh-15" parent="1" style="rounded=1;fillColor=#fadbd8;strokeColor=#c0392b;fontSize=10;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Poller retries&#xa;every 1 second&#xa;MAX_RETRY=5&#xa;Logged as CRITICAL" vertex="1">
          <mxGeometry height="55" width="150" x="570" y="910" as="geometry" />
        </mxCell>
        <mxCell id="yJfWwOfNQ-Znc4rAKRkh-16" parent="1" style="rounded=1;fillColor=#d5f5e3;strokeColor=#27ae60;fontSize=10;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Kafka RECOVERS&#xa;send() succeeds&#xa;published=true ✅&#xa;Consumer gets event" vertex="1">
          <mxGeometry height="58" width="150" x="810" y="907" as="geometry" />
        </mxCell>
        <mxCell id="yJfWwOfNQ-Znc4rAKRkh-17" edge="1" parent="1" source="yJfWwOfNQ-Znc4rAKRkh-13" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#c0392b;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" target="yJfWwOfNQ-Znc4rAKRkh-14" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="yJfWwOfNQ-Znc4rAKRkh-18" edge="1" parent="1" source="yJfWwOfNQ-Znc4rAKRkh-14" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#c0392b;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" target="yJfWwOfNQ-Znc4rAKRkh-15" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="yJfWwOfNQ-Znc4rAKRkh-19" edge="1" parent="1" source="yJfWwOfNQ-Znc4rAKRkh-15" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#27ae60;fontSize=9;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" target="yJfWwOfNQ-Znc4rAKRkh-16" value="Kafka back">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="yJfWwOfNQ-Znc4rAKRkh-20" parent="1" style="rounded=1;fillColor=#ede9fe;strokeColor=#7b2d8b;fontSize=10;align=left;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Outbox + Avro: Base64 bridge&#xa;─────────────────────────────────────────────────────&#xa;Problem: outbox payload=JSONB (text). Avro=binary bytes. Can&#39;t store binary in JSONB.&#xa;Fix: KafkaAvroSerializer.serialize() → bytes → Base64.encode() → store as text&#xa;Poller: Base64.decode() → raw bytes → bytesKafkaTemplate (ByteArraySerializer) → Kafka&#xa;Consumer: KafkaAvroDeserializer reads magic byte → schema ID → typed object" vertex="1">
          <mxGeometry height="100" width="580" x="820" y="980" as="geometry" />
        </mxCell>
        <mxCell id="yJfWwOfNQ-Znc4rAKRkh-21" parent="1" style="rounded=1;fillColor=#e8f4fd;strokeColor=#2980b9;fontSize=11;align=left;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Architecture Decision: Outbox over direct Kafka publish&#xa;Option A (direct): fast, simple, NO guarantee if Kafka down at publish time&#xa;Option B (outbox): ~1s latency, GUARANTEED — event survives even if Kafka is down for hours&#xa;Banking choice: outbox — cannot silently lose a transaction event" vertex="1">
          <mxGeometry height="80" width="760" x="50" y="990" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
