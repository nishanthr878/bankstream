          <mxGeometry height="120" width="175" x="200" y="120" as="geometry" />
        </mxCell>
        <mxCell id="3zYKDeG8nNZXjcPaYTb--4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;verticalAlign=top;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="TransactionService&#xa;─────────────────&#xa;@Service @Transactional&#xa;&#xa;1. Build Transaction&#xa;2. repo.save(tx)&#xa;3. Build Event&#xa;4. producer.publish()&#xa;5. TX commits → INSERT" vertex="1">
          <mxGeometry height="150" width="185" x="425" y="105" as="geometry" />
        </mxCell>
        <mxCell id="3zYKDeG8nNZXjcPaYTb--5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;verticalAlign=top;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="TransactionProducer&#xa;─────────────────────&#xa;@Component&#xa;@Qualifier(&quot;avroKafkaTemplate&quot;)&#xa;&#xa;kafkaTemplate.send(&#xa;  &quot;transaction.initiated&quot;,&#xa;  accountId, ← partition key&#xa;  avroEvent  ← value&#xa;)&#xa;→ CompletableFuture" vertex="1">
          <mxGeometry height="160" width="200" x="650" y="100" as="geometry" />
        </mxCell>
        <mxCell id="3zYKDeG8nNZXjcPaYTb--6" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;verticalAlign=top;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Kafka Broker&#xa;─────────────────────&#xa;hash(accountId) % 3&#xa;→ select partition&#xa;&#xa;ACC001→P0 (kafka1 leads)&#xa;ACC002→P1 (kafka2 leads)&#xa;ACC003→P2 (kafka1 leads)&#xa;&#xa;Follower PULLS from leader&#xa;ISR=[1,2] → sends ack&#xa;Offset assigned = 5" vertex="1">
          <mxGeometry height="175" width="210" x="1010" y="92.5" as="geometry" />
        </mxCell>
        <mxCell id="3zYKDeG8nNZXjcPaYTb--7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;verticalAlign=top;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="notification-service&#xa;─────────────────────────&#xa;@KafkaListener&#xa;group=notification-service&#xa;concurrency=3&#xa;AckMode=MANUAL_IMMEDIATE&#xa;&#xa;consumer.poll(100ms)&#xa;process(record)&#xa;acknowledgment.acknowledge()&#xa;→ offset committed" vertex="1">
          <mxGeometry height="185" width="210" x="1360" y="87.5" as="geometry" />
        </mxCell>
