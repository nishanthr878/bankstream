        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f9ff;strokeColor=#0077b6;strokeWidth=2;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="" vertex="1">
          <mxGeometry height="785" width="140" x="170" y="335" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#0077b6;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;Docker Compose&lt;/b&gt;&#xa;&#xa;Runs all services&#xa;locally in containers&#xa;&#xa;docker compose up -d" vertex="1">
          <mxGeometry height="80" width="120" x="180" y="345" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-13" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#0077b6;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;Kafka Cluster&lt;/b&gt;&#xa;(KRaft — no ZooKeeper)&#xa;&#xa;kafka1: Controller+Broker&#xa;Port 9092 / 29092&#xa;&#xa;kafka2: Broker only&#xa;Port 9094 / 29094&#xa;&#xa;CLUSTER_ID must match" vertex="1">
          <mxGeometry height="130" width="120" x="180" y="435" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-14" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#0077b6;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;Schema Registry&lt;/b&gt;&#xa;Port 8081&#xa;&#xa;Stores Avro schemas&#xa;in _schemas topic&#xa;&#xa;REST API for&#xa;schema management" vertex="1">
          <mxGeometry height="100" width="120" x="180" y="575" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-15" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#0077b6;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;Kafka UI&lt;/b&gt;&#xa;Port 8080&#xa;&#xa;View topics, messages,&#xa;consumer groups, lag,&#xa;schemas visually" vertex="1">
          <mxGeometry height="80" width="120" x="180" y="685" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-16" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#0077b6;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;PostgreSQL 16&lt;/b&gt;&#xa;Port 5432&#xa;&#xa;Tables: accounts,&#xa;transactions, outbox,&#xa;processed_events,&#xa;fraud_alerts&#xa;&#xa;init.sql runs once&#xa;on first boot" vertex="1">
          <mxGeometry height="120" width="120" x="180" y="775" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-17" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#0077b6;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;Topics Created&lt;/b&gt;&#xa;(manual — auto-create OFF)&#xa;&#xa;transaction.initiated (3p,r2)&#xa;transaction.completed (3p,r2)&#xa;transaction.failed (3p,r2)&#xa;fraud.alert (3p,r2)&#xa;transaction.dlq (1p,r2)&#xa;account.created (compact)" vertex="1">
          <mxGeometry height="185" width="120" x="180" y="905" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-18" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fff4;strokeColor=#2d6a4f;strokeWidth=2;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="" vertex="1">
          <mxGeometry height="785" width="140" x="325" y="335" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-19" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#2d6a4f;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;transaction-service&lt;/b&gt;&#xa;Port 8090&#xa;&#xa;REST: POST /api/transactions&#xa;&#xa;Takes: accountId, amount,&#xa;type (DEBIT/CREDIT),&#xa;description" vertex="1">
          <mxGeometry height="135" width="120" x="335" y="345" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#2d6a4f;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;KafkaProducer&lt;/b&gt;&#xa;Config (CRITICAL):&#xa;&#xa;acks=all&#xa;(wait for all ISR)&#xa;&#xa;enable-idempotence=true&#xa;(dedup retries)&#xa;&#xa;max.in.flight=5&#xa;(must be ≤5 for&#xa;idempotence to work)&#xa;&#xa;linger.ms=5&#xa;batch-size=32KB" vertex="1">
          <mxGeometry height="215" width="120" x="335" y="490" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#2d6a4f;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;Partition Key&lt;/b&gt;&#xa;= accountId&#xa;&#xa;hash(accountId) % 3&#xa;= partition number&#xa;&#xa;Same account →&#xa;same partition →&#xa;ordered per account&#xa;&#xa;No key = round-robin&#xa;= no ordering" vertex="1">
          <mxGeometry height="175" width="120" x="335" y="715" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-22" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#2d6a4f;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;Two KafkaTemplates&lt;/b&gt;&#xa;(Phase 2 → Phase 5)&#xa;&#xa;objectKafkaTemplate&#xa;→ JsonSerializer&#xa;→ typed Java objects&#xa;&#xa;stringKafkaTemplate&#xa;→ StringSerializer&#xa;→ raw JSON strings&#xa;(outbox payload)&#xa;&#xa;avroKafkaTemplate&#xa;→ KafkaAvroSerializer&#xa;→ binary Avro" vertex="1">
          <mxGeometry height="190" width="120" x="335" y="910" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-23" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffbf0;strokeColor=#d97706;strokeWidth=2;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="" vertex="1">
          <mxGeometry height="785" width="140" x="480" y="335" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-24" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;The Problem&lt;/b&gt;&#xa;(Dual-Write)&#xa;&#xa;repo.save(tx)  ✓&#xa;kafka.send()   ✗ CRASH&#xa;&#xa;DB committed but&#xa;event lost forever&#xa;&#xa;@Transactional&#xa;does NOT help —&#xa;Kafka is outside&#xa;JpaTransactionManager" vertex="1">
          <mxGeometry height="160" width="120" x="490" y="345" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-25" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;The Fix: Outbox&lt;/b&gt;&#xa;&#xa;Single DB transaction:&#xa;INSERT transactions&#xa;INSERT outbox&#xa;(published=false)&#xa;&#xa;Both or NEITHER&#xa;= atomicity guaranteed" vertex="1">
          <mxGeometry height="120" width="120" x="490" y="575" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-26" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;OutboxPoller&lt;/b&gt;&#xa;@Scheduled(1000ms)&#xa;@Transactional&#xa;&#xa;SELECT * FROM outbox&#xa;WHERE published=false&#xa;FOR UPDATE SKIP LOCKED&#xa;&#xa;SKIP LOCKED = multiple&#xa;instances don&#39;t race&#xa;&#xa;send().get() = sync&#xa;marks published=true" vertex="1">
          <mxGeometry height="215" width="120" x="490" y="740" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-27" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;Outbox + Avro&lt;/b&gt;&#xa;(Phase 5 update)&#xa;&#xa;Problem: can&#39;t store&#xa;Avro binary in JSONB&#xa;&#xa;Fix: Base64 encode&#xa;Avro bytes → store&#xa;as text in outbox&#xa;&#xa;Poller: Base64 decode&#xa;→ send raw bytes&#xa;via bytesKafkaTemplate" vertex="1">
          <mxGeometry height="160" width="120" x="490" y="960" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-28" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#c0392b;strokeWidth=2;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="" vertex="1">
          <mxGeometry height="785" width="140" x="635" y="335" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-29" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde8e8;strokeColor=#c0392b;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;notification-service&lt;/b&gt;&#xa;Port 8091&#xa;&#xa;Consumes:&#xa;transaction.initiated&#xa;&#xa;Group ID:&#xa;notification-service&#xa;&#xa;Concurrency: 3&#xa;(matches partitions)" vertex="1">
          <mxGeometry height="145" width="120" x="645" y="345" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-30" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde8e8;strokeColor=#c0392b;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;Manual Offset Commit&lt;/b&gt;&#xa;AckMode.MANUAL_IMMEDIATE&#xa;&#xa;Auto-commit = DANGER&#xa;fires on timer, not&#xa;after processing&#xa;&#xa;Manual = commit ONLY&#xa;after processing + DB&#xa;write both succeed&#xa;&#xa;At-least-once delivery&#xa;= need idempotency" vertex="1">
          <mxGeometry height="225" width="120" x="645" y="495" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-31" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde8e8;strokeColor=#c0392b;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;Retry + Backoff&lt;/b&gt;&#xa;&#xa;Attempt 1 → fail&#xa;Wait 1s (2^0 * 1000)&#xa;&#xa;Attempt 2 → fail&#xa;Wait 2s (2^1 * 1000)&#xa;&#xa;Attempt 3 → fail&#xa;Wait 4s (2^2 * 1000)&#xa;&#xa;Total: 7s before DLQ&#xa;Must be &lt; max.poll&#xa;.interval.ms (5min)" vertex="1">
          <mxGeometry height="200" width="120" x="645" y="740" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-32" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde8e8;strokeColor=#c0392b;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;Dead Letter Queue&lt;/b&gt;&#xa;topic: transaction.dlq&#xa;&#xa;After max retries:&#xa;1. send to DLQ&#xa;2. ack original offset&#xa;&#xa;MUST ack — without it&#xa;consumer stuck on same&#xa;offset forever&#xa;&#xa;DLQ = 1 partition&#xa;for ordered inspection" vertex="1">
          <mxGeometry height="160" width="120" x="645" y="950" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-33" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f0ff;strokeColor=#7b2d8b;strokeWidth=2;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="" vertex="1">
          <mxGeometry height="785" width="140" x="790" y="335" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-34" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7b2d8b;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;Why Avro?&lt;/b&gt;&#xa;&#xa;JSON = no contract&#xa;Producer changes field&#xa;→ all consumers break&#xa;silently at runtime&#xa;&#xa;Avro = enforced contract&#xa;Schema Registry rejects&#xa;breaking changes at&#xa;PUBLISH TIME&#xa;not runtime" vertex="1">
          <mxGeometry height="155" width="120" x="800" y="345" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-35" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7b2d8b;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;Avro Wire Format&lt;/b&gt;&#xa;&#xa;[0x00][schema_id 4B][binary]&#xa;&#xa;0x00 = magic byte&#xa;schema_id = int from&#xa;Schema Registry&#xa;binary = Avro encoded&#xa;&#xa;NOT JSON — binary&#xa;Kafka UI needs SR&#xa;to decode it" vertex="1">
          <mxGeometry height="165" width="120" x="800" y="495" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-36" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7b2d8b;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;Schema Evolution&lt;/b&gt;&#xa;&#xa;BACKWARD (default):&#xa;new schema reads old data&#xa;Remove field = OK ✓&#xa;(consumer ignores it)&#xa;&#xa;FULL (use this):&#xa;both directions&#xa;Remove required field&#xa;= REJECTED ✗&#xa;&#xa;Add optional field&#xa;with default = OK ✓" vertex="1">
          <mxGeometry height="225" width="120" x="800" y="670" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-37" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7b2d8b;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;Code Generation&lt;/b&gt;&#xa;&#xa;.avsc schema file&#xa;→ avro-maven-plugin&#xa;→ Java class generated&#xa;in target/generated-sources&#xa;&#xa;No Lombok — Avro&#xa;generates its own&#xa;getters/setters/builder&#xa;&#xa;Use: Event.newBuilder()&#xa;  .setField(value)&#xa;  .build()" vertex="1">
          <mxGeometry height="210" width="120" x="800" y="905" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-38" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0fff4;strokeColor=#166534;strokeWidth=2;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="" vertex="1">
          <mxGeometry height="680" width="140" x="945" y="335" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-39" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#166534;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;fraud-detection-service&lt;/b&gt;&#xa;Port 8092&#xa;&#xa;Kafka Streams app&#xa;(not a consumer/producer&#xa;— it&#39;s a library)&#xa;&#xa;Reads: transaction.initiated&#xa;Reads: account.created&#xa;Writes: fraud.alert" vertex="1">
          <mxGeometry height="120" width="120" x="955" y="345" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-40" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#166534;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;GlobalKTable&lt;/b&gt;&#xa;account.created topic&#xa;&#xa;Every instance gets&#xa;ALL account data&#xa;(unlike KTable which&#xa;is partition-scoped)&#xa;&#xa;Used for enrichment:&#xa;tx + account tier&#xa;&#xa;Topic must be&#xa;COMPACTED — never&#xa;loses account data" vertex="1">
          <mxGeometry height="160" width="120" x="955" y="475" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-41" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#166534;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;3 Fraud Rules&lt;/b&gt;&#xa;&#xa;Rule 1: HIGH_VALUE&#xa;Amount &gt; tier threshold&#xa;STANDARD: 50k&#xa;PREMIUM: 1L&#xa;ELITE: 5L&#xa;(needs GlobalKTable join)&#xa;&#xa;Rule 2: VELOCITY&#xa;3+ tx in 5 min&#xa;Sliding window&#xa;&#xa;Rule 3: RAPID_LARGE&#xa;Total &gt; 1L in 1 hour&#xa;Tumbling window" vertex="1">
          <mxGeometry height="200" width="120" x="955" y="645" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-42" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#166534;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;RocksDB State&lt;/b&gt;&#xa;&#xa;Windowed aggregations&#xa;stored locally in RocksDB&#xa;&#xa;Backed by changelog&#xa;topic in Kafka&#xa;&#xa;On restart: replays&#xa;changelog to rebuild&#xa;state (can be slow&#xa;for large state)&#xa;&#xa;Exactly-once:&#xa;EXACTLY_ONCE_V2" vertex="1">
          <mxGeometry height="150" width="120" x="955" y="855" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-43" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdf4ff;strokeColor=#7b2d8b;strokeWidth=2;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="" vertex="1">
          <mxGeometry height="855" width="160" x="1140" y="335" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-44" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#7b2d8b;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;Topic → Partition → Broker&lt;/b&gt;&#xa;&#xa;Topic = just a name (metadata)&#xa;Partition = actual data dir on disk&#xa;/kafka-logs/topic-N/&#xa;  .log (messages)&#xa;  .index (sparse offset map)&#xa;&#xa;Partition distributed across brokers&#xa;Leader: serves reads+writes&#xa;Follower: silent replica&#xa;&#xa;Ordering: per-partition ONLY" vertex="1">
          <mxGeometry height="150" width="140" x="1150" y="345" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-45" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#7b2d8b;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;ISR + Replication&lt;/b&gt;&#xa;&#xa;ISR = In-Sync Replicas&#xa;= caught up within&#xa;replica.lag.time.max.ms&#xa;&#xa;acks=all = wait for&#xa;ALL ISR (not all replicas)&#xa;&#xa;min.insync.replicas=2&#xa;= reject write if ISR&lt;2&#xa;&#xa;BOTH required together&#xa;One without other = weak" vertex="1">
          <mxGeometry height="140" width="140" x="1150" y="505" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-46" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#7b2d8b;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;Consumer Groups&lt;/b&gt;&#xa;&#xa;1 partition → max 1&#xa;consumer per group&#xa;&#xa;3 partitions = max 3&#xa;parallel consumers&#xa;4th consumer = idle&#xa;&#xa;Rebalance = all pause&#xa;triggers on: join, leave,&#xa;partition change&#xa;&#xa;Static membership fixes&#xa;unnecessary rebalances" vertex="1">
          <mxGeometry height="150" width="140" x="1150" y="655" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-47" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#7b2d8b;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;Offsets&lt;/b&gt;&#xa;&#xa;Stored in __consumer_offsets&#xa;topic — NOT in consumer&#xa;&#xa;Consumer dying = ZERO&#xa;offset loss&#xa;&#xa;Rebalance: new consumer&#xa;reads last committed&#xa;offset, resumes there&#xa;&#xa;At-least-once: messages&#xa;in-flight when crash&#xa;= redelivered on restart" vertex="1">
          <mxGeometry height="195" width="140" x="1150" y="815" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-79" edge="1" parent="1" source="rMTppRQt1AwlNReHd2rY-48" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="rMTppRQt1AwlNReHd2rY-70" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-48" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3e8ff;strokeColor=#7b2d8b;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;Windowing Types&lt;/b&gt;&#xa;&#xa;Tumbling: fixed, no overlap&#xa;[0-1hr][1-2hr][2-3hr]&#xa;Each event in 1 window&#xa;&#xa;Hopping: fixed, overlap&#xa;Events in multiple windows&#xa;&#xa;Sliding: per-message window&#xa;of last N minutes&#xa;Best for velocity detection&#xa;&#xa;Session: gap-based, dynamic&#xa;Closes after inactivity" vertex="1">
          <mxGeometry height="180" width="140" x="1150" y="1000" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-49" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff5f5;strokeColor=#c0392b;strokeWidth=2;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="" vertex="1">
          <mxGeometry height="680" width="160" x="1315" y="335" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-50" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde8e8;strokeColor=#c0392b;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;#1 Debug Rule&lt;/b&gt;&#xa;&#xa;Read stack trace&#xa;BOTTOM UP&#xa;&#xa;Last &quot;Caused by:&quot; =&#xa;root cause&#xa;&#xa;Everything above =&#xa;Spring/Kafka wrapper&#xa;= noise&#xa;&#xa;Act on the LAST&#xa;Caused by only" vertex="1">
          <mxGeometry height="130" width="140" x="1325" y="345" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-51" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde8e8;strokeColor=#c0392b;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;Error: Unknown magic byte&lt;/b&gt;&#xa;&#xa;Cause: consumer expects Avro&#xa;but reading old JSON message&#xa;&#xa;Fix: delete + recreate topic&#xa;clear outbox table&#xa;Add ErrorHandlingDeserializer" vertex="1">
          <mxGeometry height="90" width="140" x="1325" y="485" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-52" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde8e8;strokeColor=#c0392b;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;Error: Could not instantiate&#xa;com.fasterxml.jackson&#xa;.databind.JsonSerializer&lt;/b&gt;&#xa;&#xa;Cause: wrong import —&#xa;Jackson abstract class&#xa;&#xa;Fix: import&#xa;org.springframework.kafka&#xa;.support.serializer&#xa;.JsonSerializer" vertex="1">
          <mxGeometry height="120" width="140" x="1325" y="585" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-53" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde8e8;strokeColor=#c0392b;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;Error: column payload is jsonb&#xa;but expression is varchar&lt;/b&gt;&#xa;&#xa;Cause: Hibernate sends&#xa;String as VARCHAR&#xa;&#xa;Fix: add BOTH annotations:&#xa;@Column(columnDefinition=&quot;jsonb&quot;)&#xa;@JdbcTypeCode(SqlTypes.JSON)" vertex="1">
          <mxGeometry height="110" width="140" x="1325" y="715" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-54" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde8e8;strokeColor=#c0392b;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;Error: required bean&#xa;KafkaTemplate not found&lt;/b&gt;&#xa;&#xa;Cause: two beans same raw&#xa;type — type erasure means&#xa;KafkaTemplate&lt;String,Object&gt;&#xa;and KafkaTemplate&lt;String,String&gt;&#xa;look the same at runtime&#xa;&#xa;Fix: @Bean(&quot;name&quot;) +&#xa;@Qualifier(&quot;name&quot;)&#xa;Write constructor manually&#xa;(remove @RequiredArgsConstructor)" vertex="1">
          <mxGeometry height="150" width="140" x="1325" y="835" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-55" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef9f0;strokeColor=#e67e22;strokeWidth=2;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="" vertex="1">
          <mxGeometry height="680" width="160" x="1490" y="335" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-56" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebd0;strokeColor=#e67e22;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;Type 1: Poison Pill&lt;/b&gt;&#xa;Message always fails&#xa;processing&#xa;&#xa;Symptom:&#xa;Lag grows forever&#xa;Consumer stuck at&#xa;same offset&#xa;&#xa;Fix: DLQ after N retries&#xa;+ ack original offset&#xa;&#xa;Without ack = infinite&#xa;loop on same message" vertex="1">
          <mxGeometry height="150" width="140" x="1500" y="345" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-57" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebd0;strokeColor=#e67e22;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;Type 2: Wrong Format&lt;/b&gt;&#xa;Deserialization fails&#xa;before your code runs&#xa;&#xa;Symptom:&#xa;SerializationException&#xa;Consumer thread crashes&#xa;&#xa;Fix: ErrorHandlingDeserializer&#xa;wraps actual deserializer&#xa;passes error to listener&#xa;listener routes to DLQ" vertex="1">
          <mxGeometry height="140" width="140" x="1500" y="505" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-58" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebd0;strokeColor=#e67e22;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;Type 3: Offset Out of Range&lt;/b&gt;&#xa;Consumer down longer&#xa;than retention period&#xa;&#xa;Symptom:&#xa;OffsetOutOfRangeException&#xa;Committed offset points&#xa;to deleted segment&#xa;&#xa;Fix options:&#xa;A) Increase retention&#xa;B) Seek to specific offset&#xa;C) CLI reset:&#xa;kafka-consumer-groups&#xa;--reset-offsets&#xa;--to-earliest&#xa;--execute" vertex="1">
          <mxGeometry height="190" width="140" x="1500" y="655" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-59" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdebd0;strokeColor=#e67e22;fontSize=10;align=center;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;Monitor Consumer Lag&lt;/b&gt;&#xa;&#xa;Lag = latest offset -&#xa;committed offset&#xa;&#xa;Lag growing = problem&#xa;Lag = 0 = healthy&#xa;&#xa;CLI:&#xa;kafka-consumer-groups&#xa;--describe&#xa;--group notification-service&#xa;&#xa;Look at LAG column&#xa;This is your #1&#xa;health metric" vertex="1">
          <mxGeometry height="150" width="140" x="1500" y="855" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-60" edge="1" parent="1" source="rMTppRQt1AwlNReHd2rY-19" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=0;entryX=0.5;entryY=1;fontSize=9;fontColor=#333333;strokeColor=#2d6a4f;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" target="rMTppRQt1AwlNReHd2rY-25" value="POST /api/transactions">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-61" edge="1" parent="1" source="rMTppRQt1AwlNReHd2rY-37" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=9;fontColor=#7b2d8b;strokeColor=#7b2d8b;dashed=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" target="rMTppRQt1AwlNReHd2rY-35" value="Avro binary&#xa;(magic byte + schema_id + payload)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-62" edge="1" parent="1" source="rMTppRQt1AwlNReHd2rY-35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;exitX=0.5;exitY=0;entryX=0.5;entryY=1;fontSize=9;fontColor=#c0392b;strokeColor=#c0392b;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" target="rMTppRQt1AwlNReHd2rY-29" value="KafkaAvroDeserializer&#xa;→ typed object">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-63" edge="1" parent="1" source="rMTppRQt1AwlNReHd2rY-35" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;exitX=1;exitY=0.5;entryX=0;entryY=0.5;fontSize=9;fontColor=#166534;strokeColor=#166534;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" target="rMTppRQt1AwlNReHd2rY-39" value="Kafka Streams&#xa;reads same topic">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-64" parent="1" style="text;html=1;strokeColor=none;fillColor=#1a1a2e;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1;fontColor=#ffffff;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="SERVICE CONTRACTS (What each service publishes and consumes)" vertex="1">
          <mxGeometry height="30" width="780" x="175" y="1200" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-65" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#2d6a4f;fontSize=10;align=left;verticalAlign=top;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;transaction-service (8090)&lt;/b&gt;&#xa;&#xa;PRODUCES → transaction.initiated&#xa;Key: accountId&#xa;Value: TransactionInitiatedEvent (Avro)&#xa;Fields: eventId, transactionId, accountId,&#xa;amount, currency, type, description,&#xa;occurredAt, merchantId (optional)&#xa;&#xa;PRODUCES → account.created (on startup)&#xa;Key: accountId&#xa;Value: AccountEvent (Avro)&#xa;Fields: accountId, accountNumber,&#xa;ownerName, tier, status&#xa;&#xa;DB WRITES: transactions + outbox (atomic)" vertex="1">
          <mxGeometry height="200" width="240" x="170" y="1230" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-66" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fde8e8;strokeColor=#c0392b;fontSize=10;align=left;verticalAlign=top;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;notification-service (8091)&lt;/b&gt;&#xa;&#xa;CONSUMES ← transaction.initiated&#xa;Group: notification-service&#xa;Deserializer: KafkaAvroDeserializer&#xa;specific.avro.reader=true&#xa;→ typed TransactionInitiatedEvent&#xa;&#xa;PRODUCES → transaction.dlq&#xa;On: max retries exceeded&#xa;&#xa;DB READS/WRITES: processed_events&#xa;(idempotency guard — UUID PK)&#xa;&#xa;DELIVERY: at-least-once&#xa;+ idempotent consumer" vertex="1">
          <mxGeometry height="200" width="240" x="425" y="1230" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-67" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d1fae5;strokeColor=#166534;fontSize=10;align=left;verticalAlign=top;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;fraud-detection-service (8092)&lt;/b&gt;&#xa;&#xa;CONSUMES (KStream) ← transaction.initiated&#xa;CONSUMES (GlobalKTable) ← account.created&#xa;&#xa;PRODUCES → fraud.alert&#xa;Key: accountId&#xa;Value: FraudAlertEvent (Avro)&#xa;Fields: alertId, accountId, transactionId,&#xa;alertType, reason, amount,&#xa;accountTier, detectedAt&#xa;&#xa;ALERT TYPES:&#xa;HIGH_VALUE: amount &gt; tier threshold&#xa;VELOCITY: 3+ tx in 5min (sliding window)&#xa;RAPID_LARGE: total &gt; 1L in 1hr (tumbling)" vertex="1">
          <mxGeometry height="200" width="270" x="675" y="1240" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-68" parent="1" style="text;html=1;strokeColor=none;fillColor=#1a1a2e;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=13;fontStyle=1;fontColor=#ffffff;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="SCHEMA REGISTRY (http://localhost:8081) — Registered Subjects" vertex="1">
          <mxGeometry height="30" width="685" x="965" y="1200" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-69" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7b2d8b;fontSize=10;align=left;verticalAlign=top;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;transaction.initiated-value&lt;/b&gt;&#xa;&#xa;Version 1 (original):&#xa;eventId, transactionId, accountId,&#xa;amount, currency, type,&#xa;description (optional), occurredAt&#xa;&#xa;Version 2 (Phase 5 update):&#xa;+ merchantId (optional, default=null)&#xa;&#xa;Compatibility: FULL&#xa;(both backward AND forward)&#xa;&#xa;Breaking change test:&#xa;Remove amount → REJECTED ✗&#xa;Add optional field → ACCEPTED ✓" vertex="1">
          <mxGeometry height="200" width="220" x="965" y="1240" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-70" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7b2d8b;fontSize=10;align=left;verticalAlign=top;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;account.created-value&lt;/b&gt;&#xa;&#xa;Version 1:&#xa;accountId, accountNumber,&#xa;ownerName, tier, status&#xa;&#xa;Topic config:&#xa;cleanup.policy=compact&#xa;(never loses account data)&#xa;&#xa;Compaction keeps only&#xa;latest message per key&#xa;= GlobalKTable can always&#xa;rebuild full account state&#xa;on restart" vertex="1">
          <mxGeometry height="200" width="220" x="1210" y="1240" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-71" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7b2d8b;fontSize=10;align=left;verticalAlign=top;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;b&gt;fraud.alert-value&lt;/b&gt;&#xa;&#xa;Version 1:&#xa;alertId, accountId, transactionId,&#xa;alertType, reason, amount,&#xa;accountTier, detectedAt&#xa;&#xa;alertType values:&#xa;HIGH_VALUE&#xa;VELOCITY&#xa;RAPID_LARGE&#xa;&#xa;detectedAt = epoch millis&#xa;(Avro has no Instant type)&#xa;Convert: Instant.ofEpochMilli()" vertex="1">
          <mxGeometry height="200" width="225" x="1440" y="1240" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-72" parent="1" style="text;html=1;strokeColor=#0077b6;fillColor=#caf0f8;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=1;fontSize=12;fontStyle=1;fontColor=#0077b6;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="LEARNING PROGRESSION →" vertex="1">
          <mxGeometry height="30" width="885" x="185" y="1470" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-73" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="1. Run docker compose&#xa;→ see containers start" vertex="1">
          <mxGeometry height="35" width="130" x="170" y="1510" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-74" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="2. Send HTTP request&#xa;→ see Kafka message" vertex="1">
          <mxGeometry height="35" width="130" x="310" y="1510" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-75" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="3. Kill Kafka → tx saved&#xa;→ Kafka recovers → delivered" vertex="1">
          <mxGeometry height="35" width="130" x="465" y="1510" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-76" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="4. Send .99 amount&#xa;→ see DLQ message" vertex="1">
          <mxGeometry height="35" width="130" x="620" y="1510" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-77" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="5. Check Schema Registry&#xa;→ see 2 versions registered" vertex="1">
          <mxGeometry height="35" width="130" x="765" y="1520" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-78" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;fontSize=10;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="6. Send 150k transaction&#xa;→ see fraud.alert fired" vertex="1">
          <mxGeometry height="35" width="130" x="910" y="1520" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
