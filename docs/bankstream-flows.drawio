          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mui85cja-ccYRbV_Qy9Y-11" edge="1" parent="1" source="mui85cja-ccYRbV_Qy9Y-6" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#27ae60;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" target="mui85cja-ccYRbV_Qy9Y-7" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mui85cja-ccYRbV_Qy9Y-12" parent="1" style="text;html=1;fillColor=#fadbd8;strokeColor=#c0392b;align=left;fontStyle=1;fontSize=11;fontColor=#c0392b;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="❌ FAILURE PATH — Poison pill goes through retry → DLQ" vertex="1">
          <mxGeometry height="24" width="600" x="180" y="410" as="geometry" />
        </mxCell>
        <mxCell id="mui85cja-ccYRbV_Qy9Y-13" parent="1" style="rounded=1;fillColor=#fadbd8;strokeColor=#c0392b;fontSize=10;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Consume msg&#xa;amount=999.99&#xa;(simulated fail)" vertex="1">
          <mxGeometry height="55" width="130" x="180" y="445" as="geometry" />
        </mxCell>
        <mxCell id="mui85cja-ccYRbV_Qy9Y-14" parent="1" style="rounded=1;fillColor=#fadbd8;strokeColor=#c0392b;fontSize=10;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Attempt 1 FAILS&#xa;RuntimeException&#xa;wait 1s (2^0 * 1000)" vertex="1">
          <mxGeometry height="55" width="140" x="335" y="445" as="geometry" />
        </mxCell>
        <mxCell id="mui85cja-ccYRbV_Qy9Y-15" parent="1" style="rounded=1;fillColor=#fadbd8;strokeColor=#c0392b;fontSize=10;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Attempt 2 FAILS&#xa;RuntimeException&#xa;wait 2s (2^1 * 1000)" vertex="1">
          <mxGeometry height="55" width="140" x="500" y="445" as="geometry" />
        </mxCell>
        <mxCell id="mui85cja-ccYRbV_Qy9Y-16" parent="1" style="rounded=1;fillColor=#fadbd8;strokeColor=#c0392b;fontSize=10;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Attempt 3 FAILS&#xa;RuntimeException&#xa;MAX_RETRIES hit" vertex="1">
          <mxGeometry height="55" width="140" x="665" y="445" as="geometry" />
        </mxCell>
        <mxCell id="mui85cja-ccYRbV_Qy9Y-17" parent="1" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="dlqProducer.sendToDlq()&#xa;→ transaction.dlq topic&#xa;→ manual inspection" vertex="1">
          <mxGeometry height="55" width="155" x="830" y="445" as="geometry" />
        </mxCell>
        <mxCell id="mui85cja-ccYRbV_Qy9Y-18" parent="1" style="rounded=1;fillColor=#d5f5e3;strokeColor=#27ae60;fontSize=10;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="acknowledgment&#xa;.acknowledge()&#xa;← MUST ack original!&#xa;Offset advances" vertex="1">
          <mxGeometry height="55" width="150" x="1010" y="445" as="geometry" />
        </mxCell>
        <mxCell id="mui85cja-ccYRbV_Qy9Y-19" edge="1" parent="1" source="mui85cja-ccYRbV_Qy9Y-13" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#c0392b;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" target="mui85cja-ccYRbV_Qy9Y-14" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mui85cja-ccYRbV_Qy9Y-20" edge="1" parent="1" source="mui85cja-ccYRbV_Qy9Y-14" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#c0392b;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" target="mui85cja-ccYRbV_Qy9Y-15" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mui85cja-ccYRbV_Qy9Y-21" edge="1" parent="1" source="mui85cja-ccYRbV_Qy9Y-15" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#c0392b;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" target="mui85cja-ccYRbV_Qy9Y-16" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mui85cja-ccYRbV_Qy9Y-22" edge="1" parent="1" source="mui85cja-ccYRbV_Qy9Y-16" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#c0392b;fontSize=9;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" target="mui85cja-ccYRbV_Qy9Y-17" value="DLQ">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mui85cja-ccYRbV_Qy9Y-23" edge="1" parent="1" source="mui85cja-ccYRbV_Qy9Y-17" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#27ae60;fontSize=9;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" target="mui85cja-ccYRbV_Qy9Y-18" value="MUST ack!">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mui85cja-ccYRbV_Qy9Y-24" parent="1" style="rounded=1;fillColor=#fef9e7;strokeColor=#f39c12;fontSize=11;align=left;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Why MUST you acknowledge() after DLQ routing?&#xa;────────────────────────────────────────────────────────────────────────────────────────────────&#xa;WITHOUT ack: offset=5 never committed → consumer restarts → reads offset=5 again → fails again → DLQ again → INFINITE LOOP&#xa;WITH ack: offset=5 committed → consumer reads offset=6 → continues normally&#xa;The DLQ is where the problem lives now. The original topic must move on." vertex="1">
          <mxGeometry height="80" width="900" x="180" y="520" as="geometry" />
        </mxCell>
        <mxCell id="mui85cja-ccYRbV_Qy9Y-25" parent="1" style="rounded=1;fillColor=#d5f5e3;strokeColor=#27ae60;fontSize=11;align=left;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Idempotency Guard — processed_events table&#xa;────────────────────────────────────────────────────────────────────────────────────────────────────────────────────&#xa;At-least-once delivery = messages CAN be redelivered (rebalance, crash between process+ack)&#xa;Guard: check processed_events by eventId (UUID PRIMARY KEY) before processing&#xa;If found → skip (already done) → ack → continue&#xa;If not found → process → INSERT processed_events → ack&#xa;Race condition: 2 instances process same msg simultaneously → 2nd INSERT fails with PK violation&#xa;→ catch DataIntegrityViolationException → treat as duplicate → ack → continue (safe)" vertex="1">
          <mxGeometry height="120" width="1100" x="180" y="620" as="geometry" />
        </mxCell>
        <mxCell id="mui85cja-ccYRbV_Qy9Y-26" parent="1" style="rounded=1;fillColor=#e8f4fd;strokeColor=#2980b9;fontSize=11;align=left;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Architecture Decision: DLQ over infinite retry&#xa;Infinite retry: consumer blocked forever on poison pill → all msgs behind it stuck → LAG GROWS&#xa;DLQ: after N retries, message moved to transaction.dlq → consumer continues → manual inspection&#xa;transaction.dlq has 1 partition (ordered inspection) + replication-factor=2 (durable)" vertex="1">
          <mxGeometry height="80" width="760" x="180" y="758" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="PMCzvRmRfz6h2Y6NgdYy" name="Avro">
    <mxGraphModel dx="1357" dy="844" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="_k602q0rn5mzXV7NrRC2-1" parent="1" style="text;html=1;fillColor=#1a1a2e;strokeColor=none;align=center;fontStyle=1;fontSize=14;fontColor=#ffffff;whiteSpace=wrap;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&amp;nbsp;Avro + Schema Registry — Schema evolution · Backward compatibility · Wire format" vertex="1">
          <mxGeometry height="36" width="1600" x="60" y="370" as="geometry" />
        </mxCell>
        <mxCell id="_k602q0rn5mzXV7NrRC2-2" parent="1" style="text;html=1;fillColor=#fadbd8;strokeColor=#c0392b;align=left;fontStyle=1;fontSize=11;fontColor=#c0392b;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="❌ THE PROBLEM — JSON has no contract. Producer changes field → all consumers break silently" vertex="1">
          <mxGeometry height="24" width="800" x="60" y="415" as="geometry" />
        </mxCell>
        <mxCell id="_k602q0rn5mzXV7NrRC2-3" parent="1" style="rounded=1;fillColor=#fadbd8;strokeColor=#c0392b;fontSize=10;align=left;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="// Producer v1 sends:&#xa;{&quot;amount&quot;: 1500, &quot;type&quot;: &quot;DEBIT&quot;}&#xa;&#xa;// Producer renames field (v2):&#xa;{&quot;amount&quot;: 1500, &quot;txType&quot;: &quot;DEBIT&quot;}&#xa;                   ↑ renamed!&#xa;&#xa;// Consumer still reads:&#xa;event.get(&quot;type&quot;)  → null&#xa;&#xa;// No error at publish time&#xa;// Breaks silently at runtime&#xa;// 5 consumers all fail" vertex="1">
          <mxGeometry height="185" width="260" x="60" y="448" as="geometry" />
        </mxCell>
        <mxCell id="_k602q0rn5mzXV7NrRC2-4" parent="1" style="text;html=1;fillColor=#d5f5e3;strokeColor=#27ae60;align=left;fontStyle=1;fontSize=11;fontColor=#1e8449;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="✅ HAPPY PATH — Avro schema enforces contract, Registry catches breaking changes at publish time" vertex="1">
          <mxGeometry height="24" width="780" x="50" y="750" as="geometry" />
        </mxCell>
        <mxCell id="_k602q0rn5mzXV7NrRC2-5" parent="1" style="rounded=1;fillColor=#ede9fe;strokeColor=#7b2d8b;fontSize=10;align=left;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value=".avsc schema file&#xa;────────────────────────&#xa;{&quot;type&quot;:&quot;record&quot;,&#xa; &quot;name&quot;:&quot;TransactionInitiatedEvent&quot;,&#xa; &quot;fields&quot;:[&#xa;  {&quot;name&quot;:&quot;eventId&quot;,&quot;type&quot;:&quot;string&quot;},&#xa;  {&quot;name&quot;:&quot;amount&quot;,&quot;type&quot;:&quot;double&quot;},&#xa;  {&quot;name&quot;:&quot;description&quot;,&#xa;   &quot;type&quot;:[&quot;null&quot;,&quot;string&quot;],&#xa;   &quot;default&quot;:null}  ← optional!&#xa; ]}&#xa;&#xa;avro-maven-plugin generates&#xa;Java class with builder" vertex="1">
          <mxGeometry height="200" width="240" x="60" y="810" as="geometry" />
        </mxCell>
        <mxCell id="_k602q0rn5mzXV7NrRC2-6" parent="1" style="rounded=1;fillColor=#ede9fe;strokeColor=#7b2d8b;fontSize=10;align=left;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Schema Registry&#xa;http://localhost:8081&#xa;────────────────────────────────&#xa;Subjects registered:&#xa;transaction.initiated-value v1&#xa;transaction.initiated-value v2&#xa;account.created-value v1&#xa;fraud.alert-value v1&#xa;&#xa;API endpoints:&#xa;GET /subjects&#xa;GET /subjects/{name}/versions&#xa;POST /compatibility/... (check)&#xa;PUT /config/{name} (set mode)&#xa;&#xa;Compatibility mode: FULL&#xa;(both backward AND forward)" vertex="1">
          <mxGeometry height="215" width="255" x="380" y="810" as="geometry" />
        </mxCell>
        <mxCell id="_k602q0rn5mzXV7NrRC2-7" parent="1" style="rounded=1;fillColor=#ede9fe;strokeColor=#7b2d8b;fontSize=10;align=left;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Wire Format (binary)&#xa;────────────────────────────────&#xa;[0x00][schemaId 4B][Avro binary]&#xa;&#xa;0x00 = Confluent magic byte&#xa;schemaId = integer (e.g. 1, 2)&#xa;Avro binary = compact encoded&#xa;&#xa;vs JSON: {&quot;eventId&quot;:&quot;abc&quot;,...}&#xa;Avro binary ≈ 15 bytes&#xa;JSON text  ≈ 49 bytes&#xa;&#xa;Kafka UI needs Schema Registry&#xa;to decode and display fields" vertex="1">
          <mxGeometry height="195" width="230" x="710" y="820" as="geometry" />
        </mxCell>
        <mxCell id="_k602q0rn5mzXV7NrRC2-8" parent="1" style="rounded=1;fillColor=#ede9fe;strokeColor=#7b2d8b;fontSize=10;align=left;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Compatibility Modes&#xa;────────────────────────────────────────&#xa;BACKWARD (default):&#xa;  New schema reads OLD messages&#xa;  Remove field = OK (ignores it)&#xa;  But old consumers reading NEW messages = breaks&#xa;&#xa;FORWARD:&#xa;  Old schema reads NEW messages&#xa;  Remove field = FAIL (field missing)&#xa;&#xa;FULL (we use this):&#xa;  Both directions enforced&#xa;  Add optional field (default=null) = OK ✅&#xa;  Remove required field = REJECTED ❌&#xa;  Rename field = REJECTED ❌&#xa;&#xa;Set: PUT /config/{subject} {&quot;compatibility&quot;:&quot;FULL&quot;}" vertex="1">
          <mxGeometry height="235" width="295" x="1070" y="790" as="geometry" />
        </mxCell>
        <mxCell id="_k602q0rn5mzXV7NrRC2-9" parent="1" style="text;html=1;fillColor=#fadbd8;strokeColor=#c0392b;align=left;fontStyle=1;fontSize=11;fontColor=#c0392b;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="❌ FAILURE PATH — Old JSON messages in Avro topic → Unknown magic byte" vertex="1">
          <mxGeometry height="24" width="700" x="20" y="1080" as="geometry" />
        </mxCell>
        <mxCell id="_k602q0rn5mzXV7NrRC2-10" parent="1" style="rounded=1;fillColor=#fadbd8;strokeColor=#c0392b;fontSize=10;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Phase 4: JSON msg&#xa;{&quot;eventId&quot;:...}&#xa;in topic (offset 1)" vertex="1">
          <mxGeometry height="55" width="140" x="20" y="1150" as="geometry" />
        </mxCell>
        <mxCell id="_k602q0rn5mzXV7NrRC2-11" parent="1" style="rounded=1;fillColor=#fadbd8;strokeColor=#c0392b;fontSize=10;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Phase 5: switch to&#xa;KafkaAvroDeserializer&#xa;reads offset 1" vertex="1">
          <mxGeometry height="55" width="150" x="230" y="1150" as="geometry" />
        </mxCell>
        <mxCell id="_k602q0rn5mzXV7NrRC2-12" parent="1" style="rounded=1;fillColor=#fadbd8;strokeColor=#c0392b;fontSize=10;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Deserializer looks for&#xa;0x00 magic byte&#xa;Finds 0x7B &#39;{&#39; instead&#xa;→ SerializationException&#xa;&quot;Unknown magic byte!&quot;" vertex="1">
          <mxGeometry height="70" width="175" x="450" y="1142.5" as="geometry" />
        </mxCell>
        <mxCell id="_k602q0rn5mzXV7NrRC2-13" parent="1" style="rounded=1;fillColor=#d5f5e3;strokeColor=#27ae60;fontSize=10;align=left;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Fix:&#xa;1. Delete topic (removes old JSON msgs)&#xa;2. Recreate topic&#xa;3. Add ErrorHandlingDeserializer wrapper&#xa;   (catches deser errors → routes to DLQ)" vertex="1">
          <mxGeometry height="70" width="250" x="735" y="1142.5" as="geometry" />
        </mxCell>
        <mxCell id="_k602q0rn5mzXV7NrRC2-14" edge="1" parent="1" source="_k602q0rn5mzXV7NrRC2-10" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#c0392b;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" target="_k602q0rn5mzXV7NrRC2-11" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_k602q0rn5mzXV7NrRC2-15" edge="1" parent="1" source="_k602q0rn5mzXV7NrRC2-11" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#c0392b;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" target="_k602q0rn5mzXV7NrRC2-12" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_k602q0rn5mzXV7NrRC2-16" edge="1" parent="1" source="_k602q0rn5mzXV7NrRC2-12" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#27ae60;fontSize=9;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" target="_k602q0rn5mzXV7NrRC2-13" value="fix →">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="_k602q0rn5mzXV7NrRC2-17" parent="1" style="rounded=1;fillColor=#e8f4fd;strokeColor=#2980b9;fontSize=11;align=left;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Architecture Decision: FULL compatibility mode over BACKWARD&#xa;BACKWARD alone: remove field = compatible (new schema ignores it in old msgs)&#xa;→ But old consumers reading new messages would BREAK — not caught!&#xa;FULL: remove field = INCOMPATIBLE — caught at PUBLISH TIME, not runtime&#xa;Banking rule: breaking changes must fail before bad data enters Kafka" vertex="1">
          <mxGeometry height="90" width="780" x="30" y="1240" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="ipT7oXfEVSABNVT5VjDZ" name="Kafka Streams">
    <mxGraphModel dx="2207" dy="844" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="INKo3yjzZIdx3rJwrc9k-1" parent="1" style="text;html=1;fillColor=#1a1a2e;strokeColor=none;align=center;fontStyle=1;fontSize=14;fontColor=#ffffff;whiteSpace=wrap;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&amp;nbsp;Kafka Streams — Aggregations · Windowing · Stream-Table Join · Fraud Detection" vertex="1">
          <mxGeometry height="36" width="1600" x="120" y="190" as="geometry" />
        </mxCell>
        <mxCell id="INKo3yjzZIdx3rJwrc9k-2" parent="1" style="rounded=1;fillColor=#d5f5e3;strokeColor=#166534;fontSize=11;align=left;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Kafka Streams is a LIBRARY (not a separate cluster)&#xa;────────────────────────────────────────────────────────────────────────────────&#xa;Runs inside fraud-detection-service JVM process&#xa;Scales by running more instances of the app (same application-id = streams cluster)&#xa;State stored in RocksDB locally, replicated via changelog topic to Kafka" vertex="1">
          <mxGeometry height="70" width="900" x="115" y="250" as="geometry" />
        </mxCell>
        <mxCell id="INKo3yjzZIdx3rJwrc9k-3" parent="1" style="text;html=1;fillColor=#d5f5e3;strokeColor=#27ae60;align=left;fontStyle=1;fontSize=11;fontColor=#1e8449;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="✅ HAPPY PATH — HIGH_VALUE fraud detection flow" vertex="1">
          <mxGeometry height="24" width="500" x="130" y="360" as="geometry" />
        </mxCell>
        <mxCell id="INKo3yjzZIdx3rJwrc9k-4" parent="1" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=10;align=left;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="KStream&#xa;transaction.initiated&#xa;──────────────────────&#xa;Key: accountId&#xa;Value: TransactionInitiatedEvent&#xa;(Avro, typed)&#xa;&#xa;builder.stream(&#xa;  &quot;transaction.initiated&quot;,&#xa;  Consumed.with(&#xa;    Serdes.String(),&#xa;    avroSerde&#xa;  ))" vertex="1">
          <mxGeometry height="185" width="210" x="120" y="420" as="geometry" />
        </mxCell>
        <mxCell id="INKo3yjzZIdx3rJwrc9k-5" parent="1" style="rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="GlobalKTable&#xa;account.created&#xa;──────────────────────────────&#xa;Key: accountId&#xa;Value: AccountEvent (Avro)&#xa;&#xa;EVERY instance gets ALL keys&#xa;(unlike KTable = partition-scoped)&#xa;&#xa;Loaded on startup by replaying&#xa;entire compacted topic&#xa;&#xa;Topic: cleanup.policy=compact&#xa;→ never loses account data&#xa;→ retains latest per key forever&#xa;&#xa;AccountSeeder publishes 3 accounts&#xa;on transaction-service startup" vertex="1">
          <mxGeometry height="235" width="260" x="-110" y="890" as="geometry" />
        </mxCell>
        <mxCell id="INKo3yjzZIdx3rJwrc9k-6" parent="1" style="rounded=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Stream-Table Join&#xa;──────────────────────────────────────&#xa;transactions.join(accountTable,&#xa;  (key, tx) -&gt; tx.getAccountId(),&#xa;  (tx, account) -&gt; new EnrichedTransaction(tx, account)&#xa;)&#xa;&#xa;Result: EnrichedTransaction&#xa;  = transaction + account tier&#xa;&#xa;GlobalKTable join: any partition&#xa;can join with any account key&#xa;(KTable join: only same partition)" vertex="1">
          <mxGeometry height="190" width="290" x="410" y="420" as="geometry" />
        </mxCell>
        <mxCell id="INKo3yjzZIdx3rJwrc9k-7" parent="1" style="rounded=1;fillColor=#fadbd8;strokeColor=#c0392b;fontSize=10;align=left;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Rule 1: HIGH_VALUE&#xa;──────────────────────────────────────────&#xa;enriched.filter((key, et) -&gt; {&#xa;  threshold = AccountTier&#xa;    .fromString(et.account.getTier())&#xa;    .getHighValueThreshold();&#xa;  // STANDARD=50k PREMIUM=1L ELITE=5L&#xa;  return et.tx.getAmount() &gt; threshold;&#xa;})&#xa;.mapValues(et -&gt; buildAlert(...))&#xa;.to(&quot;fraud.alert&quot;)&#xa;&#xa;↑ Needs GlobalKTable join for tier" vertex="1">
          <mxGeometry height="190" width="280" x="765" y="420" as="geometry" />
        </mxCell>
        <mxCell id="INKo3yjzZIdx3rJwrc9k-8" parent="1" style="rounded=1;fillColor=#fadbd8;strokeColor=#c0392b;fontSize=10;align=left;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Rule 2: VELOCITY&#xa;──────────────────────────────────────────────────&#xa;transactions (raw stream, not enriched)&#xa;.groupByKey()&#xa;.windowedBy(&#xa;  SlidingWindows.ofTimeDifferenceAndGrace(&#xa;    Duration.ofMinutes(5),    ← window size&#xa;    Duration.ofSeconds(30)    ← grace for late events&#xa;  )&#xa;)&#xa;.count(Materialized.as(&quot;velocity-store&quot;))&#xa;.toStream()&#xa;.filter((k, count) -&gt; count &gt;= 3)&#xa;.map((k, count) -&gt; buildVelocityAlert())&#xa;.to(&quot;fraud.alert&quot;)&#xa;&#xa;Sliding window: each message gets its own&#xa;window of last 5min (catches any 3-in-5min)" vertex="1">
          <mxGeometry height="250" width="310" x="1500" y="1000" as="geometry" />
        </mxCell>
        <mxCell id="INKo3yjzZIdx3rJwrc9k-9" parent="1" style="rounded=1;fillColor=#fadbd8;strokeColor=#c0392b;fontSize=10;align=left;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Rule 3: RAPID_LARGE&#xa;────────────────────────────────────────────────────────────────────────────&#xa;transactions (raw stream)&#xa;.groupByKey()&#xa;.windowedBy(TimeWindows.ofSizeAndGrace(Duration.ofHours(1), grace))&#xa;.aggregate(&#xa;  () -&gt; 0.0,                        ← initializer&#xa;  (key, tx, total) -&gt; total + tx.getAmount(), ← accumulator&#xa;  Materialized.as(&quot;hourly-spend-store&quot;)&#xa;)&#xa;.toStream()&#xa;.filter((k, total) -&gt; total &gt; 100_000.0)&#xa;.to(&quot;fraud.alert&quot;)&#xa;&#xa;Tumbling 1hr window: fixed [10:00-11:00][11:00-12:00] non-overlapping" vertex="1">
          <mxGeometry height="225" width="355" x="1490" y="610" as="geometry" />
        </mxCell>
        <mxCell id="INKo3yjzZIdx3rJwrc9k-10" parent="1" style="rounded=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="fraud.alert topic&#xa;────────────────────────────────────────────────&#xa;FraudAlertEvent (Avro):&#xa;alertId, accountId, transactionId,&#xa;alertType (HIGH_VALUE/VELOCITY/RAPID_LARGE),&#xa;reason, amount, accountTier, detectedAt" vertex="1">
          <mxGeometry height="110" width="310" x="750" y="960" as="geometry" />
        </mxCell>
        <mxCell id="INKo3yjzZIdx3rJwrc9k-11" edge="1" parent="1" source="INKo3yjzZIdx3rJwrc9k-4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#27ae60;fontSize=9;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" target="INKo3yjzZIdx3rJwrc9k-6" value="join">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="INKo3yjzZIdx3rJwrc9k-12" edge="1" parent="1" source="INKo3yjzZIdx3rJwrc9k-5" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#6c8ebf;fontSize=9;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" target="INKo3yjzZIdx3rJwrc9k-6" value="lookup">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="INKo3yjzZIdx3rJwrc9k-13" edge="1" parent="1" source="INKo3yjzZIdx3rJwrc9k-6" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#27ae60;fontSize=9;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" target="INKo3yjzZIdx3rJwrc9k-7" value="enriched">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="INKo3yjzZIdx3rJwrc9k-14" edge="1" parent="1" source="INKo3yjzZIdx3rJwrc9k-4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#c0392b;fontSize=9;exitX=0.5;exitY=1;entryX=0;entryY=0.5;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" target="INKo3yjzZIdx3rJwrc9k-8" value="raw tx">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="INKo3yjzZIdx3rJwrc9k-15" edge="1" parent="1" source="INKo3yjzZIdx3rJwrc9k-4" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#c0392b;fontSize=9;exitX=0.5;exitY=1;entryX=0;entryY=0.5;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" target="INKo3yjzZIdx3rJwrc9k-9" value="raw tx">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="INKo3yjzZIdx3rJwrc9k-16" edge="1" parent="1" source="INKo3yjzZIdx3rJwrc9k-7" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#c0392b;fontSize=9;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" target="INKo3yjzZIdx3rJwrc9k-10" value="HIGH_VALUE alert">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="INKo3yjzZIdx3rJwrc9k-17" edge="1" parent="1" source="INKo3yjzZIdx3rJwrc9k-8" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#c0392b;fontSize=9;exitX=0;exitY=0.5;entryX=1;entryY=0.5;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" target="INKo3yjzZIdx3rJwrc9k-10" value="VELOCITY alert">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="INKo3yjzZIdx3rJwrc9k-18" edge="1" parent="1" source="INKo3yjzZIdx3rJwrc9k-9" style="edgeStyle=orthogonalEdgeStyle;strokeColor=#c0392b;fontSize=9;exitX=0;exitY=0.5;entryX=1;entryY=0;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" target="INKo3yjzZIdx3rJwrc9k-10" value="RAPID_LARGE alert">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="INKo3yjzZIdx3rJwrc9k-19" parent="1" style="text;html=1;fillColor=#fadbd8;strokeColor=#c0392b;align=left;fontStyle=1;fontSize=11;fontColor=#c0392b;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="❌ FAILURE PATH — EnrichedTransaction has no Serde (serde design mistake)" vertex="1">
          <mxGeometry height="24" width="700" x="65" y="1380" as="geometry" />
        </mxCell>
        <mxCell id="INKo3yjzZIdx3rJwrc9k-20" parent="1" style="rounded=1;fillColor=#fadbd8;strokeColor=#c0392b;fontSize=10;align=left;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Wrong approach:&#xa;enriched.groupByKey()  ← type is EnrichedTransaction&#xa;→ Kafka Streams needs a Serde to serialize to RocksDB&#xa;→ EnrichedTransaction is a Java record, not Avro&#xa;→ No Serde exists → SerializationException&#xa;&#xa;Fix: Rule 2 + Rule 3 operate on RAW transactions (before join)&#xa;Only Rule 1 needs enrichment (account tier for threshold)&#xa;Raw transactions have SpecificAvroSerde → works fine" vertex="1">
          <mxGeometry height="140" width="500" x="60" y="1440" as="geometry" />
        </mxCell>
        <mxCell id="INKo3yjzZIdx3rJwrc9k-21" parent="1" style="rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="RocksDB State + Windowing&#xa;─────────────────────────────────────────────────────────────────────────────────────────────────────────&#xa;velocity-count-store: RocksDB on disk, backed by changelog topic in Kafka&#xa;hourly-spend-store:   RocksDB on disk, backed by changelog topic in Kafka&#xa;&#xa;On restart: replay changelog topic → rebuild RocksDB (can be slow for large state)&#xa;Exactly-once: StreamsConfig.EXACTLY_ONCE_V2 → atomic read+process+write+commit&#xa;&#xa;Window types used:&#xa;Sliding (velocity): each message creates own window of last 5min → catches any 3-in-5min pattern&#xa;Tumbling (spend):   fixed 1hr windows [10-11][11-12] → total per account per hour" vertex="1">
          <mxGeometry height="140" width="900" x="610" y="1440" as="geometry" />
        </mxCell>
        <mxCell id="INKo3yjzZIdx3rJwrc9k-22" parent="1" style="rounded=1;fillColor=#e8f4fd;strokeColor=#2980b9;fontSize=11;align=left;whiteSpace=wrap;html=1;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Architecture Decision: GlobalKTable for account enrichment&#xa;KTable join: partition 0 consumer can only join with keys on partition 0 → misses other accounts&#xa;GlobalKTable: EVERY instance has ALL account keys → any tx can join with any account&#xa;Trade-off: GlobalKTable = full data in memory per instance → only for small datasets (account configs, tiers)&#xa;account.created uses cleanup.policy=compact → data never lost on retention → GlobalKTable always rebuildable" vertex="1">
          <mxGeometry height="90" width="1100" x="60" y="1605" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="nCVz3te2e2bDkIwCoEH8" name="Page-6">
    <mxGraphModel dx="1357" dy="844" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rMTppRQt1AwlNReHd2rY-1" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#666666;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="Read left to right → Each phase builds on the previous. Each box = one concept you implemented." vertex="1">
          <mxGeometry height="25" width="1250" x="350" y="250" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-2" parent="1" style="text;html=1;strokeColor=#0077b6;fillColor=#caf0f8;align=center;verticalAlign=middle;rounded=1;fontSize=11;fontStyle=1;fontColor=#0077b6;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="PHASE 1&#xa;Infrastructure" vertex="1">
          <mxGeometry height="35" width="140" x="170" y="285" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-3" parent="1" style="text;html=1;strokeColor=#0077b6;fillColor=#caf0f8;align=center;verticalAlign=middle;rounded=1;fontSize=11;fontStyle=1;fontColor=#0077b6;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="PHASE 2&#xa;Producer/Consumer" vertex="1">
          <mxGeometry height="35" width="140" x="325" y="285" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-4" parent="1" style="text;html=1;strokeColor=#0077b6;fillColor=#caf0f8;align=center;verticalAlign=middle;rounded=1;fontSize=11;fontStyle=1;fontColor=#0077b6;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="PHASE 3&#xa;Outbox Pattern" vertex="1">
          <mxGeometry height="35" width="140" x="480" y="285" as="geometry" />
        </mxCell>
        <mxCell id="rMTppRQt1AwlNReHd2rY-5" parent="1" style="text;html=1;strokeColor=#0077b6;fillColor=#caf0f8;align=center;verticalAlign=middle;rounded=1;fontSize=11;fontStyle=1;fontColor=#0077b6;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="PHASE 4&#xa;DLQ + Retry" vertex="1">
          <mxGeometry height="35" width="140" x="635" y="285" as="geometry" />
        </mxCell>
